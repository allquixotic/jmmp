{
  "name": "jmmp",
  "version": "0.0.1",
  "private": true,
  "description": "Just My Music Player",
  "license": "Apache-2.0",
  "author": "Sean McNamara",
  "repository": {
    "type": "git",
    "url": "https://github.com/allquixotic/jmmp.git"
  },
  "homepage": "https://github.com/allquixotic/jmmp#readme",
  "workspaces": [
    "shared",
    "server",
    "client",
    "client/src-pwa"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green 'bun --cwd=server run dev' 'bun --cwd=client run dev'",
    "test": "bun --cwd=server run test && bun --cwd=client run test",
    "typecheck": "bun build/typecheck.ts",
    "build": "bun build/build.ts",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:spotify": "playwright test -c e2e/spotify.config.ts",
    "e2e:moq": "bun run build && playwright test -c e2e/moq.config.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.5",
    "@playwright/test": "^1.64.0",
    "concurrently": "^10.0.6",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2"
  }
}
