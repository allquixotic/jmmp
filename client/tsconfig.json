{
  "extends": "./.quasar/tsconfig.json",
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "types": ["@quasar/app-vite/client", "wicg-file-system-access"]
  },
  "include": [
    ".quasar/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.vue",
    "src-pwa/**/*.ts",
    "src-pwa/**/*.d.ts",
    "quasar.config.ts"
  ],
  "exclude": ["src/test", "src-pwa/custom-service-worker.ts"]
}
